    {
      "parameters": {
        "jsCode": "// Resgata os dados usando os nomes exatos dos nós que definimos nos Passos 1 e 2\nconst n8nWorkflows = $('Get many workflows').all();\nconst githubFiles = $('List files').all();\n\nconst operations = [];\n\nfor (const item of n8nWorkflows) {\n  const wf = item.json;\n  \n  // Limpa o nome do fluxo removendo caracteres especiais que quebram caminhos de arquivo\n  const safeName = wf.name.replace(/[^a-zA-Z0-9 \\-_]/g, '').trim();\n  const expectedPath = `workflows/${wf.id} - ${safeName}.json`;\n\n  // Verifica se a pasta no repositório já possui um arquivo que inicie com esse ID\n  const existingFile = githubFiles.find(f => f.json.name && f.json.name.startsWith(`${wf.id} -`));\n\n  const fileContent = JSON.stringify(wf, null, 2);\n\n  if (existingFile) {\n    if (existingFile.json.path === expectedPath) {\n      // O arquivo tem o nome correto. Marcamos para ATUALIZAR.\n      operations.push({\n        json: { action: 'update', path: expectedPath, content: fileContent, commitMessage: `Update: ${wf.name}`, sha: existingFile.json.sha }\n      });\n    } else {\n      // O fluxo foi renomeado! Marcamos o arquivo antigo para DELETAR, e o novo para CRIAR.\n      operations.push({\n        json: { action: 'delete', path: existingFile.json.path, commitMessage: `Rename (Del): ${existingFile.json.name}`, sha: existingFile.json.sha }\n      });\n      operations.push({\n        json: { action: 'create', path: expectedPath, content: fileContent, commitMessage: `Rename (Add): ${wf.name}` }\n      });\n    }\n  } else {\n    // O fluxo é novo, nunca foi feito backup. Marcamos para CRIAR do zero.\n    operations.push({\n      json: { action: 'create', path: expectedPath, content: fileContent, commitMessage: `New Backup: ${wf.name}` }\n    });\n  }\n}\n\nreturn operations;"
      },
      "type": "n8n-nodes-base.code",
